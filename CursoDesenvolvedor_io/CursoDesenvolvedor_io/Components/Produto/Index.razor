@page "/produtos"
@using System.Globalization
@using CursoDesenvolvedor_io.Components.Produto
@using CursoDesenvolvedor_io.Data
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IDbContextFactory<CursoDesenvolvedor_io.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="produtos/novo">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Produto">
    <PropertyColumn Align="Align.Center" Property="produto => produto.Nome" />
    <PropertyColumn Align="Align.Center" Property="produto => produto.Categoria" />
    <PropertyColumn Align="Align.Center" Property="p => p.Preco" Title="Preço" Format="C" />
    <PropertyColumn Align="Align.Center" Property="produto => produto.Disponivel" />
    <PropertyColumn Align="Align.Center" Property="produto => produto.Datavalidade" Title="Data de Validade" Format="dd-MM-yyyy" />

    <TemplateColumn Align="Align.Center" Context="produto">
        <a class="btn btn-primary" href="@($"produtos/editar/{produto.ID}")"><span class="fa fa-pencil-alt"></span></a> |
        <a class="btn btn-info" href="@($"produtos/detalhes/{produto.ID}")"><span class="fa fa-search"></span></a> |
        <a class="btn btn-danger" href="@($"produtos/deletar/{produto.ID}")"><span class="fa fa-trash"></span></a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
